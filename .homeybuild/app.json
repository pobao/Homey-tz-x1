{
  "$schema": "https://apps-sdk.homey.app/schemas/app.json",
  "id": "com.tzx1.smartscenebutton",
  "version": "1.3.1",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#2c3e50",
  "name": {
    "en": "TZ-X1 Smart Scene Button"
  },
  "description": {
    "en": "Tuya Zigbee TZ-X1 rotary scene knob — logs all Zigbee cluster messages"
  },
  "tags": {
    "en": ["tuya", "zigbee", "scene", "button", "rotary", "knob", "tz-x1"]
  },
  "category": ["appliances"],
  "permissions": [],
  "capabilities": {
    "rotate_left": {
      "type": "boolean",
      "title": { "en": "Rotate Left" },
      "getable": false,
      "setable": false,
      "uiComponent": null,
      "icon": "/assets/icon.svg"
    },
    "rotate_right": {
      "type": "boolean",
      "title": { "en": "Rotate Right" },
      "getable": false,
      "setable": false,
      "uiComponent": null,
      "icon": "/assets/icon.svg"
    }
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "Developer",
    "email": "dev@example.com"
  },
  "drivers": [
    {
      "id": "tz-x1",
      "name": {
        "en": "TZ-X1 Smart Scene Button"
      },
      "class": "remote",
      "capabilities": ["button", "rotate_left", "rotate_right", "measure_battery"],
      "images": {
        "small": "/drivers/tz-x1/assets/images/small.png",
        "large": "/drivers/tz-x1/assets/images/large.png"
      },
      "zigbee": {
        "manufacturerName": [
          "_TZ3000_gwkzibhs"
        ],
        "modelId": [
          "TS004F"
        ],
        "productId": ["TS004F"],
        "endpoints": {
          "1": {
            "clusters": [0, 1, 5, 6, 8, 57345],
            "bindings": [5, 6, 8, 57345]
          }
        },
        "learnmode": {
          "instruction": {
            "en": "Put the TZ-X1 into pairing mode by pressing and holding the center button for 5 seconds until the LED blinks rapidly."
          }
        }
      },
      "pair": [
        {
          "id": "start",
          "navigation": {
            "next": "list_devices"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "button_pressed",
        "title": {
          "en": "Button pressed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "rotated_left",
        "title": {
          "en": "Knob rotated left"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "rotated_right",
        "title": {
          "en": "Knob rotated right"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "double_pressed",
        "title": {
          "en": "Button double pressed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "long_pressed",
        "title": {
          "en": "Button long pressed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "press_rotate_right",
        "title": {
          "en": "Knob pressed and rotated right"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "press_rotate_left",
        "title": {
          "en": "Knob pressed and rotated left"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "knob_rotated",
        "title": {
          "en": "Knob rotated"
        },
        "tokens": [
          {
            "name": "direction",
            "type": "string",
            "title": { "en": "Direction" },
            "example": { "en": "right" }
          },
          {
            "name": "speed",
            "type": "string",
            "title": { "en": "Speed" },
            "example": { "en": "fast" }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "battery_low",
        "title": {
          "en": "Battery is low (below 20%)"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      },
      {
        "id": "battery_critical",
        "title": {
          "en": "Battery is critical (below 10%)"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "battery_less_than",
        "title": {
          "en": "Battery level is less than [[percentage]]%"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=tz-x1&capabilities=measure_battery"
          },
          {
            "name": "percentage",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 1,
            "title": { "en": "Battery percentage" }
          }
        ]
      }
    ]
  }
}
